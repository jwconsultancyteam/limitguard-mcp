{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.limitguard.api/trust-intelligence",
  "title": "LimitGuard Trust Intelligence",
  "description": "Entity verification, sanctions screening, and trust scoring for AI agents via x402 micropayments.",
  "version": "1.2.1",
  "websiteUrl": "https://limitguard.ai",
  "repository": {
    "url": "https://github.com/jwconsultancyteam/limitguard-mcp",
    "source": "github"
  },
  "packages": [],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.limitguard.ai/mcp"
    }
  ],
  "tools": [
    {
      "name": "check_entity",
      "description": "Full trust intelligence check on a business entity. Returns trust score (0-100), risk level, and recommendation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_name": {
            "type": "string",
            "description": "Full legal name of the entity"
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code"
          },
          "kvk_number": {
            "type": "string",
            "description": "Optional Dutch KVK number (8 digits)"
          },
          "domain": {
            "type": "string",
            "description": "Optional company website domain"
          }
        },
        "required": [
          "entity_name",
          "country"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "check_agent",
      "description": "Verify AI agent trust. Checks if an AI agent is trusted based on its identifier.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "Unique agent identifier"
          },
          "agent_name": {
            "type": "string",
            "description": "Human-readable agent name"
          }
        },
        "required": [
          "agent_id",
          "agent_name"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_trust_score",
      "description": "Quick trust score lookup by entity ID. Returns cached score if available.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Entity identifier (KVK number, domain, or hash)"
          }
        },
        "required": [
          "entity_id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "verify_wallet",
      "description": "Check wallet trust score for crypto payments. Supports EVM and Solana addresses.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "wallet_address": {
            "type": "string",
            "description": "Blockchain wallet address"
          },
          "chain_id": {
            "type": "string",
            "description": "CAIP-2 chain ID (default: eip155:8453 for Base)"
          }
        },
        "required": [
          "wallet_address"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_risk_score",
      "description": "Quick risk assessment without full trust check. Focuses on risk signals only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_name": {
            "type": "string",
            "description": "Full legal name of the entity"
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code"
          }
        },
        "required": [
          "entity_name",
          "country"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
